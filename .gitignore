# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# `npm pack` output. Written to the repo root, and the manual install smoke check
# in E1 (#26) runs it — so this is a file you will create again every time you
# verify the global install story, not a one-off accident.
*.tgz

# Test / coverage
coverage/

# dogear runtime state.
# The queue is scratch — annotations are transient and machine-local. The
# config IS meant to be committed, hence the negation.
.dogear/*
!.dogear/config.json

# Claude Code local state.
# ntfy.url holds an ntfy topic, which is a shared secret — anyone who knows the
# string can read or post your notifications. It must never be committed.
.claude/ntfy.url
.claude/settings.local.json
.claude/.turn-*

# Throwaway PR body written by /pr-prep
.pr-body.md

# Secrets
.env
.env.*
!.env.example

# OS / editor noise
.DS_Store
Thumbs.db
*.log

# NOTE: .codegraph/ is not listed here — it ships its own .gitignore that
# ignores everything inside it except that file.
