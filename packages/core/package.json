{
  "name": "@dogear/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Overlay UI, source resolution, and clipboard export for dogear. Framework-agnostic.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alphyn44/dogear.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./dist/index.js",
      "production": "./dist/noop.js",
      "default": "./dist/noop.js"
    }
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
