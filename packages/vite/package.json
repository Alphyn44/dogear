{
  "name": "@dogear/vite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Dev-only Vite plugin for dogear. Stamps source attributes, injects the overlay, serves the endpoint.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alphyn44/dogear.git",
    "directory": "packages/vite"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "vite": "^8.2.1"
  }
}
